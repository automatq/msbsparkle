{
  "name": "msbsparkle",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:inngest": "pnpm --filter web dev:inngest",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter web e2e",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:deploy": "pnpm --filter web db:deploy",
    "db:seed": "pnpm --filter web db:seed",
    "db:reset": "pnpm --filter web db:reset",
    "db:studio": "pnpm --filter web db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1"
}
