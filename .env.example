# Copy to .env for local development. On Vercel, set these in Project Settings → Environment
# Variables. Values below are local-dev defaults; [prod] marks what production must have
# (missing ones are logged at server start, see src/modules/shared/prod-config.ts).

# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sparkle:sparkle@localhost:5432/sparkle?schema=public
SHADOW_DATABASE_URL=postgresql://sparkle:sparkle@localhost:5432/sparkle_shadow
NEXT_PUBLIC_APP_URL=http://localhost:3000          # [prod] https://your-domain
NEXT_PUBLIC_BRAND_NAME=MSB Sparkle

# ── Country & locale (set once per company; changing them needs a redeploy) ──
NEXT_PUBLIC_COUNTRY=CA                              # CA or US: postal/ZIP format, provinces/states, labels
NEXT_PUBLIC_CURRENCY=                               # defaults from country (CAD / USD)
NEXT_PUBLIC_LOCALE=                                 # defaults from country (en-CA / en-US)
NEXT_PUBLIC_TIMEZONE=                               # company "today" and the 7am digest; defaults America/Toronto / America/New_York

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=                                        # openssl rand -base64 32
AUTH_URL=http://localhost:3000                      # [prod] https://your-domain
AUTH_ENCRYPTION_KEY=                                # 32 bytes: openssl rand -base64 32 (encrypts 2FA secrets)

# First super admin, used by `pnpm db:seed`. Production seeding refuses to run without both,
# and the password must be at least 12 characters.
SEED_ADMIN_EMAIL=admin@msbsparkle.local
SEED_ADMIN_PASSWORD=admin12345!

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_FROM="MSB Sparkle <hello@example.com>"        # [prod] a verified sending domain
SMTP_HOST=localhost                                 # local Mailpit (docker compose)
SMTP_PORT=1025
RESEND_API_KEY=                                     # [prod] when set, used instead of SMTP

# ── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                                  # [prod] sk_live_…
STRIPE_WEBHOOK_SECRET=                              # [prod] whsec_… for https://your-domain/api/webhooks/stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                 # [prod] pk_live_…
CHARGE_GRACE_MINUTES=                               # delay between job completion and charging

# ── Background jobs (Inngest) ───────────────────────────────────────────────
INNGEST_DEV=1                                       # local only: use `pnpm dev:inngest`; remove in prod
INNGEST_EVENT_KEY=                                  # [prod]
INNGEST_SIGNING_KEY=                                # [prod]
CRON_SECRET=                                        # [prod] bearer token for /api/internal/tasks

# ── File storage (job photos) ───────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=                              # [prod] Vercel Blob store (private); unset = ./uploads

# ── SMS (Twilio) ────────────────────────────────────────────────────────────
# Recommended in prod. Without it, cleaner sign-in codes and reminders go by email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                                 # +1XXXXXXXXXX

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FULLCALENDAR_LICENSE_KEY=               # [prod] needed for commercial use of the dispatch board
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_ID=
